[
  {"pattern": "[ \\t\\v\\f\\r\\n]+", "action": "IGNORAR"},
  {"pattern": "//[^\\r\\n]*", "action": "IGNORAR"},
  {"pattern": "/\\*[\\s\\S]*?\\*/", "action": "IGNORAR"},
  {"pattern": "/\\*", "action": "COMENTARIO_ABERTO"},
  {"pattern": "#[^\\r\\n]*(?:\\\\\\r?\\n[^\\r\\n]*)*", "action": "DIRECTIVE"},
  {"pattern": "(?:u8|[uUL])?\"(?:[^\"\\\\\\r\\n]|\\\\[^\\r\\n])*\"", "action": "STRING_LITERAL"},
  {"pattern": "(?:[uUL])?'(?:[^'\\\\\\r\\n]|\\\\[^\\r\\n])+'", "action": "CHAR_LITERAL"},
  {"pattern": "u8\"|[uUL]?[\"']", "action": "LITERAL_INVALIDO"},
  {"pattern": "(?:[0-9]|\\.[0-9])(?:[eEpP][+-]|[0-9a-zA-Z_.])*", "action": "NUMERO"},
  {"pattern": "_Alignas(?![a-zA-Z_0-9])", "action": "KW_ALIGNAS"},
  {"pattern": "_Alignof(?![a-zA-Z_0-9])", "action": "KW_ALIGNOF"},
  {"pattern": "_Atomic(?![a-zA-Z_0-9])", "action": "KW_ATOMIC"},
  {"pattern": "_Bool(?![a-zA-Z_0-9])", "action": "KW_BOOL"},
  {"pattern": "_Complex(?![a-zA-Z_0-9])", "action": "KW_COMPLEX"},
  {"pattern": "_Generic(?![a-zA-Z_0-9])", "action": "KW_GENERIC"},
  {"pattern": "_Imaginary(?![a-zA-Z_0-9])", "action": "KW_IMAGINARY"},
  {"pattern": "_Noreturn(?![a-zA-Z_0-9])", "action": "KW_NORETURN"},
  {"pattern": "_Static_assert(?![a-zA-Z_0-9])", "action": "KW_STATIC_ASSERT"},
  {"pattern": "_Thread_local(?![a-zA-Z_0-9])", "action": "KW_THREAD_LOCAL"},
  {"pattern": "auto(?![a-zA-Z_0-9])", "action": "KW_AUTO"},
  {"pattern": "break(?![a-zA-Z_0-9])", "action": "KW_BREAK"},
  {"pattern": "case(?![a-zA-Z_0-9])", "action": "KW_CASE"},
  {"pattern": "char(?![a-zA-Z_0-9])", "action": "KW_CHAR"},
  {"pattern": "const(?![a-zA-Z_0-9])", "action": "KW_CONST"},
  {"pattern": "continue(?![a-zA-Z_0-9])", "action": "KW_CONTINUE"},
  {"pattern": "default(?![a-zA-Z_0-9])", "action": "KW_DEFAULT"},
  {"pattern": "do(?![a-zA-Z_0-9])", "action": "KW_DO"},
  {"pattern": "double(?![a-zA-Z_0-9])", "action": "KW_DOUBLE"},
  {"pattern": "else(?![a-zA-Z_0-9])", "action": "KW_ELSE"},
  {"pattern": "enum(?![a-zA-Z_0-9])", "action": "KW_ENUM"},
  {"pattern": "extern(?![a-zA-Z_0-9])", "action": "KW_EXTERN"},
  {"pattern": "float(?![a-zA-Z_0-9])", "action": "KW_FLOAT"},
  {"pattern": "for(?![a-zA-Z_0-9])", "action": "KW_FOR"},
  {"pattern": "goto(?![a-zA-Z_0-9])", "action": "KW_GOTO"},
  {"pattern": "if(?![a-zA-Z_0-9])", "action": "KW_IF"},
  {"pattern": "inline(?![a-zA-Z_0-9])", "action": "KW_INLINE"},
  {"pattern": "int(?![a-zA-Z_0-9])", "action": "KW_INT"},
  {"pattern": "long(?![a-zA-Z_0-9])", "action": "KW_LONG"},
  {"pattern": "register(?![a-zA-Z_0-9])", "action": "KW_REGISTER"},
  {"pattern": "restrict(?![a-zA-Z_0-9])", "action": "KW_RESTRICT"},
  {"pattern": "return(?![a-zA-Z_0-9])", "action": "KW_RETURN"},
  {"pattern": "short(?![a-zA-Z_0-9])", "action": "KW_SHORT"},
  {"pattern": "signed(?![a-zA-Z_0-9])", "action": "KW_SIGNED"},
  {"pattern": "sizeof(?![a-zA-Z_0-9])", "action": "KW_SIZEOF"},
  {"pattern": "static(?![a-zA-Z_0-9])", "action": "KW_STATIC"},
  {"pattern": "struct(?![a-zA-Z_0-9])", "action": "KW_STRUCT"},
  {"pattern": "switch(?![a-zA-Z_0-9])", "action": "KW_SWITCH"},
  {"pattern": "typedef(?![a-zA-Z_0-9])", "action": "KW_TYPEDEF"},
  {"pattern": "union(?![a-zA-Z_0-9])", "action": "KW_UNION"},
  {"pattern": "unsigned(?![a-zA-Z_0-9])", "action": "KW_UNSIGNED"},
  {"pattern": "void(?![a-zA-Z_0-9])", "action": "KW_VOID"},
  {"pattern": "volatile(?![a-zA-Z_0-9])", "action": "KW_VOLATILE"},
  {"pattern": "while(?![a-zA-Z_0-9])", "action": "KW_WHILE"},
  {"pattern": "(?:List|Stack|Queue)(?![a-zA-Z_0-9])", "action": "IDENTIFIER"},
  {"pattern": "(?:add|insert|remove|get|set|push|pop|peek|enqueue|dequeue)(?![a-zA-Z_0-9])", "action": "IDENTIFIER"},
  {"pattern": "(?:size|capacity|isEmpty|isFull|clear|free)(?![a-zA-Z_0-9])", "action": "IDENTIFIER"},
  {"pattern": "[a-zA-Z_][a-zA-Z_0-9]*", "action": "IDENTIFIER"},
  {"pattern": "\\.\\.\\.", "action": "ELLIPSIS"},
  {"pattern": "->", "action": "ARROW"},
  {"pattern": "<<=|>>=|<<|>>|\\+\\+|--|&&|\\|\\||[<>!=+\\-*/%&^|]=", "action": "OPERATOR"},
  {"pattern": "\\(", "action": "LPAREN"},
  {"pattern": "\\)", "action": "RPAREN"},
  {"pattern": "\\[", "action": "LBRACKET"},
  {"pattern": "\\]", "action": "RBRACKET"},
  {"pattern": "\\{", "action": "LBRACE"},
  {"pattern": "\\}", "action": "RBRACE"},
  {"pattern": "\\.", "action": "DOT"},
  {"pattern": ",", "action": "COMMA"},
  {"pattern": ";", "action": "SEMICOLON"},
  {"pattern": ":", "action": "COLON"},
  {"pattern": "\\?", "action": "QUESTION"},
  {"pattern": "<", "action": "LESS"},
  {"pattern": ">", "action": "GREATER"},
  {"pattern": "=", "action": "ASSIGN"},
  {"pattern": "[+\\-*/%&|^~!]", "action": "OPERATOR"},
  {"pattern": ".", "action": "DESCONHECIDO"}
]
